{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": true,
      "$playerId": {
        ".write": true,
        ".validate": "newData.hasChildren(['role']) && newData.child('role').isString() && newData.child('safetyScore').isNumber() && newData.child('trustScore').isNumber() && newData.child('answeredCorrectly').isNumber()"
      }
    }
  }
}
